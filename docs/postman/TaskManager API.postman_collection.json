      "item": [
        {
          "name": "LOGIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\npm.test(\"Login realizado com sucesso\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n\r\npm.test(\"JWT foi retornado\", function () {\r\n    pm.expect(response.token).to.exist;\r\n});\r\n\r\npm.collectionVariables.set(\"token\", response.token);\r\n\r\nconsole.log(\"JWT salvo:\", response.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"Luigi@gmail.com\",\r\n    \"password\": \"123456\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}auth/login",
              "host": [
                "{{baseUrl}}auth"
              ],
              "path": [
