  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "const response = pm.response.json();\r",
          "\r",
          "pm.test(\"Login realizado com sucesso\", function () {\r",
          "    pm.response.to.have.status(200);\r",
          "});\r",
          "\r",
          "pm.test(\"Status code is 201\", function () {\r",
          "    pm.response.to.have.status(201);\r",
          "});\r",
          "\r",
          "pm.test(\"User without permission receives 403\", function () {\r",
          "    pm.response.to.have.status(403);\r",
          "});\r",
          "\r",
          "pm.test(\"JWT foi retornado\", function () {\r",
          "    pm.expect(response.token).to.exist;\r",
          "});\r",
          "\r",
          "pm.collectionVariables.set(\"token\", response.token);\r",
          "\r",
          "console.log(\"JWT salvo:\", response.token);"
        ],
        "type": "text/javascript"
      }
    }
